# Slop Checker Plugin

A real BWVI plugin that adds a `check-slop` command to analyze HTML for AI-generated design anti-patterns.

## Files

### manifest.yaml
```yaml
name: slop-checker
version: "0.1.0"
description: "Check HTML for AI slop patterns"
hooks:
  - "post_generate"
provides:
  - "command:check-slop"
```

### src/index.ts
```typescript
// Slop Checker Plugin for BWVI
// Adds: bwvi check-slop <file>

const SLOP_PATTERNS = [
  { pattern: /purple.*gradient/i, label: "紫色渐变" },
  { pattern: /lorem ipsum/i, label: "Lorem ipsum 填充" },
  { pattern: /linear-gradient.*#[89a-f][0-9a-f]{2}[0-9a-f]/i, label: "可疑渐变" },
  { pattern: /[\u{1F300}-\u{1F9FF}]{4,}/u, label: "过多 emoji" },
];

export function register(api: any) {
  api.registerCommand("check-slop", async (args: string[]) => {
    const fs = require("fs");
    const file = args[0];
    if (!file) return { error: "请提供 HTML 文件路径" };
    
    const html = fs.readFileSync(file, "utf-8");
    const issues: any[] = [];
    
    for (const s of SLOP_PATTERNS) {
      const match = html.match(s.pattern);
      if (match) issues.push({ type: s.label, matches: match.length });
    }
    
    return { file, issues, clean: issues.length === 0 };
  });
}
```

### package.json
```json
{
  "name": "slop-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Check HTML for AI slop patterns",
  "main": "src/index.ts",
  "bwvi": { "manifest": "manifest.yaml" }
}
```

## Usage

```bash
bwvi plugin init my-plugin
# Copy files above into my-plugin/
cd my-plugin
bwvi plugin install .
bwvi check-slop output.html
```
