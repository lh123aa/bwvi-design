{
  "name": "bwvi",
  "version": "0.2.1",
  "type": "module",
  "description": "Better Way of Visual Intelligence — Agent-native design decision protocol",
  "bin": {
    "bwvi": "./dist/bwvi.cjs"
  },
  "scripts": {
    "start": "node dist/bwvi.cjs",
    "dev": "npx tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "tsx src/index.ts benchmark run",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build && npm test && npm run benchmark"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "playwright": "^1.59.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tsx": "^4.0.0",
    "yaml": "^2.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lh123aa/bwvi-design.git"
  },
  "homepage": "https://github.com/lh123aa/bwvi-design",
  "keywords": [
    "design",
    "ai-agent",
    "mcp",
    "cli",
    "prototyping",
    "design-system"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "README.md",

    "README.en.md",
    "LICENSE"
  ]
}
